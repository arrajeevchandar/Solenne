rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsJournal(journalId) {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(journalId)
        ).data.userId == request.auth.uid;
    }

    function activeFriendship(friendshipId, first, second) {
      let friendship = get(
        /databases/$(database)/documents/friendships/$(friendshipId)
      ).data;
      return friendship.status == 'accepted'
        && friendship.memberIds is list
        && friendship.memberIds.size() == 2
        && first in friendship.memberIds
        && second in friendship.memberIds;
    }

    function validPublicProfile(profile, userId) {
      return profile is map
        && profile.keys().hasOnly(['uid', 'displayName', 'username', 'photoUrl'])
        && profile.uid == userId;
    }

    function validShareJournal(userId, journalId, projection, includeTranscript) {
      let journal = get(
        /databases/$(database)/documents/users/$(userId)/journals/$(journalId)
      ).data;
      return journal.analysisStatus == 'complete'
        && projection.keys().hasOnly([
          'id', 'userId', 'entryType', 'title', 'prompt', 'recordedAt',
          'durationSeconds', 'videoUrl', 'audioUrl', 'writtenText',
          'mediaMimeType', 'thumbnailUrl', 'uploadStatus', 'analysisStatus',
          'analysisStep', 'analysisVersion', 'moodLabel', 'aiInsights',
          'insightProvider', 'transcript'
        ])
        && projection.keys().hasAll([
          'id', 'userId', 'entryType', 'prompt', 'recordedAt',
          'durationSeconds', 'videoUrl', 'audioUrl', 'writtenText',
          'analysisStatus', 'aiInsights'
        ])
        && projection.id == journalId
        && projection.userId == userId
        && projection.entryType == journal.get('entryType', 'video')
        && projection.title == journal.get('title', '')
        && projection.prompt == journal.get('prompt', 'Daily reflection')
        && projection.recordedAt == journal.recordedAt
        && projection.durationSeconds == journal.get('durationSeconds', 0)
        && projection.videoUrl == journal.get('videoUrl', '')
        && projection.audioUrl == journal.get('audioUrl', '')
        && projection.writtenText == journal.get('writtenText', '')
        && projection.mediaMimeType == journal.get('mediaMimeType', '')
        && projection.thumbnailUrl == journal.get('thumbnailUrl', '')
        && projection.uploadStatus == journal.get('uploadStatus', 'saved')
        && projection.analysisStatus == 'complete'
        && projection.analysisStep == journal.get('analysisStep', '')
        && projection.analysisVersion == journal.get('analysisVersion', '')
        && projection.moodLabel == journal.get('moodLabel', null)
        && projection.aiInsights == journal.get('aiInsights', [])
        && projection.insightProvider == journal.get('insightProvider', '')
        && (
          (includeTranscript == true
            && projection.transcript == journal.get('transcript', {}))
          || (includeTranscript == false
            && !projection.keys().hasAny(['transcript']))
        );
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.usernameNormalized is string
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized)
        ).data.uid == userId;
      allow delete: if false;

      match /journals/{journalId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == journalId
          && (
            (request.resource.data.analysisStatus == 'queued'
              && get(
                /databases/$(database)/documents/users/$(userId)
              ).data.get('aiConsentGranted', true) == true
              && getAfter(
                /databases/$(database)/documents/analysis_jobs/$(journalId)
              ).data.status == 'queued')
            || (request.resource.data.analysisStatus == 'not_requested'
              && request.resource.data.analysisStep == 'consent_withdrawn'
              && get(
                /databases/$(database)/documents/users/$(userId)
              ).data.get('aiConsentGranted', true) == false
              && !existsAfter(
                /databases/$(database)/documents/analysis_jobs/$(journalId)
              ))
          );
        allow update: if signedInAs(userId)
          && resource.data.userId == userId
          && resource.data.analysisStatus == 'failed'
          && request.resource.data.userId == userId
          && request.resource.data.id == journalId
          && request.resource.data.analysisStatus == 'queued'
          && request.resource.data.analysisStep == 'queued'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'analysisStatus', 'analysisStep', 'analysisVersion',
            'analysisError', 'analysisErrorCode', 'analysisRequestedAt',
            'aiInsights', 'templateInsights', 'insightProvider'
          ])
          && getAfter(
            /databases/$(database)/documents/analysis_jobs/$(journalId)
          ).data.status == 'queued';
        allow delete: if false;
      }

    }

    match /usernames/{username} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameNormalized', 'displayName', 'photoUrl',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.usernameNormalized == username
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameNormalized == username;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameNormalized == username
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameNormalized', 'displayName', 'photoUrl',
          'updatedAt'
        ]);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameNormalized != username;
    }

    match /friendships/{friendship} {
      // A sender transaction must be able to confirm that its deterministic
      // friendship document does not exist before creating it. Existing
      // documents remain readable only by their two members.
      allow get: if request.auth != null
        && (!exists(
          /databases/$(database)/documents/friendships/$(friendship)
        ) || request.auth.uid in resource.data.memberIds);
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'requesterId', 'recipientId', 'memberIds', 'status', 'profiles',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.recipientId in request.resource.data.memberIds
        && request.resource.data.profiles.keys().hasOnly([
          request.resource.data.requesterId,
          request.resource.data.recipientId
        ])
        && validPublicProfile(
          request.resource.data.profiles[request.resource.data.requesterId],
          request.resource.data.requesterId
        )
        && validPublicProfile(
          request.resource.data.profiles[request.resource.data.recipientId],
          request.resource.data.recipientId
        )
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.memberIds == resource.data.memberIds
          && (
          (resource.data.status == 'pending'
            && request.auth.uid == resource.data.recipientId
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.status == 'pending'
            && request.auth.uid == resource.data.requesterId
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.status == 'cancelled')
          || (resource.data.status == 'accepted'
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.status == 'removed')
          || (request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['profiles', 'updatedAt'])
            && request.resource.data.profiles.diff(resource.data.profiles)
              .affectedKeys().hasOnly([request.auth.uid])
            && validPublicProfile(
              request.resource.data.profiles[request.auth.uid],
              request.auth.uid
            ))
          ))
        || (resource.data.status in ['declined', 'cancelled', 'removed']
          && request.resource.data.keys().hasOnly([
            'requesterId', 'recipientId', 'memberIds', 'status', 'profiles',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.status == 'pending'
          && request.resource.data.profiles.keys().hasOnly([
            request.resource.data.requesterId,
            request.resource.data.recipientId
          ])
          && validPublicProfile(
            request.resource.data.profiles[request.resource.data.requesterId],
            request.resource.data.requesterId
          )
          && validPublicProfile(
            request.resource.data.profiles[request.resource.data.recipientId],
            request.resource.data.recipientId
          ))
      );
      allow delete: if false;
    }

    match /conversations/{conversation} {
      function acceptedFriendshipMember() {
        let friendshipPath = /databases/$(database)/documents/friendships/$(conversation);
        return request.auth != null
          && exists(friendshipPath)
          && get(friendshipPath).data.status == 'accepted'
          && get(friendshipPath).data.memberIds is list
          && get(friendshipPath).data.memberIds.size() == 2
          && request.auth.uid in get(friendshipPath).data.memberIds;
      }

      function acceptedConversation(data) {
        return data.get('active', true) == true
          && data.memberIds is list
          && data.memberIds.size() == 2
          && activeFriendship(
            conversation,
            data.memberIds[0],
            data.memberIds[1]
          );
      }

      function otherMember(data) {
        return data.memberIds[0] == request.auth.uid
          ? data.memberIds[1]
          : data.memberIds[0];
      }

      function validConversationProfiles(data) {
        return data.profiles is map
          && data.profiles.keys().hasOnly(data.memberIds)
          && validPublicProfile(data.profiles[data.memberIds[0]], data.memberIds[0])
          && validPublicProfile(data.profiles[data.memberIds[1]], data.memberIds[1]);
      }

      allow get: if acceptedFriendshipMember()
        && (
          !exists(
            /databases/$(database)/documents/conversations/$(conversation)
          )
          || (request.auth.uid in resource.data.memberIds
            && acceptedConversation(resource.data))
        );
      allow list: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && acceptedConversation(resource.data);

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.keys().hasOnly([
          'memberIds', 'profiles', 'active', 'schemaVersion', 'lastMessageId',
          'lastMessagePreview', 'lastMessageAt', 'lastMessageSenderId',
          'unreadCounts', 'deliveredThrough', 'readThrough', 'typing',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.active == true
        && request.resource.data.schemaVersion == 1
        && request.resource.data.lastMessageId is string
        && request.resource.data.lastMessageId.size() > 0
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 140
        && request.resource.data.lastMessageSenderId == request.auth.uid
        && request.resource.data.unreadCounts[request.auth.uid] == 0
        && request.resource.data.unreadCounts[otherMember(request.resource.data)] == 1
        && validConversationProfiles(request.resource.data)
        && acceptedConversation(request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.schemaVersion == resource.data.get('schemaVersion', 1)
        && (
          (acceptedConversation(resource.data)
            && request.resource.data.active == true
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.lastMessageSenderId == request.auth.uid
            && request.resource.data.lastMessageId is string
            && request.resource.data.lastMessageId.size() > 0
            && request.resource.data.lastMessagePreview is string
            && request.resource.data.lastMessagePreview.size() <= 140
            && request.resource.data.unreadCounts[request.auth.uid] == 0
            && request.resource.data.unreadCounts[otherMember(resource.data)]
              == resource.data.unreadCounts.get(otherMember(resource.data), 0) + 1
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'lastMessageId', 'lastMessagePreview', 'lastMessageAt',
              'lastMessageSenderId', 'unreadCounts', 'deliveredThrough',
              'readThrough', 'typing', 'updatedAt'
            ]))
          || (acceptedConversation(resource.data)
            && request.resource.data.active == true
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.lastMessageId == resource.data.lastMessageId
            && request.resource.data.lastMessagePreview == resource.data.lastMessagePreview
            && request.resource.data.lastMessageAt == resource.data.lastMessageAt
            && request.resource.data.lastMessageSenderId == resource.data.lastMessageSenderId
            && request.resource.data.unreadCounts[request.auth.uid] == 0
            && request.resource.data.unreadCounts[otherMember(resource.data)]
              == resource.data.unreadCounts.get(otherMember(resource.data), 0)
            && request.resource.data.deliveredThrough
              .diff(resource.data.get('deliveredThrough', {})).affectedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.readThrough
              .diff(resource.data.get('readThrough', {})).affectedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.typing == resource.data.typing
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'unreadCounts', 'deliveredThrough', 'readThrough', 'updatedAt'
            ]))
          || (acceptedConversation(resource.data)
            && request.resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['typing', 'updatedAt'])
            && request.resource.data.typing
              .diff(resource.data.get('typing', {})).affectedKeys()
              .hasOnly([request.auth.uid])
            && request.resource.data.typing[request.auth.uid].active is bool)
          || (acceptedConversation(resource.data)
            && request.resource.data.active == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['profiles', 'updatedAt'])
            && request.resource.data.profiles.diff(resource.data.profiles)
              .affectedKeys().hasOnly([request.auth.uid])
            && validPublicProfile(
              request.resource.data.profiles[request.auth.uid],
              request.auth.uid
            ))
          || (resource.data.get('active', true) == true
            && request.resource.data.active == false
            && request.resource.data.typing == {}
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['active', 'typing', 'updatedAt'])
            && getAfter(
              /databases/$(database)/documents/friendships/$(conversation)
            ).data.status == 'removed')
        );
      allow delete: if false;

      match /messages/{message} {
        function activeConversationForMessage() {
          let conversationData = getAfter(
            /databases/$(database)/documents/conversations/$(conversation)
          ).data;
          return conversationData.memberIds is list
            && request.auth != null
            && request.auth.uid in conversationData.memberIds
            && conversationData.get('active', true) == true
            && activeFriendship(
              conversation,
              conversationData.memberIds[0],
              conversationData.memberIds[1]
            );
        }

        allow get, list: if acceptedFriendshipMember()
          && (
            !exists(
              /databases/$(database)/documents/conversations/$(conversation)
            )
            || acceptedConversation(get(
              /databases/$(database)/documents/conversations/$(conversation)
            ).data)
          );

        allow create: if activeConversationForMessage()
          && getAfter(
            /databases/$(database)/documents/conversations/$(conversation)
          ).data.lastMessageId == message
          && request.resource.data.keys().hasOnly([
            'senderId', 'type', 'body', 'shareId', 'createdAt', 'deleted',
            'deletedAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'journal_share']
          && request.resource.data.body is string
          && request.resource.data.body.size() <= 2000
          && request.resource.data.shareId is string
          && request.resource.data.deleted == false
          && request.resource.data.deletedAt == null
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.body.size() > 0
              && request.resource.data.shareId == '')
            || (request.resource.data.type == 'journal_share'
              && request.resource.data.body == ''
              && request.resource.data.shareId.size() > 0)
          );

        allow update: if request.auth != null
          && request.auth.uid == resource.data.senderId
          && activeConversationForMessage()
          && resource.data.deleted == false
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.type == resource.data.type
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.deleted == true
          && request.resource.data.body == ''
          && request.resource.data.shareId == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'body', 'shareId', 'deleted', 'deletedAt'
          ])
          && (
            getAfter(
              /databases/$(database)/documents/conversations/$(conversation)
            ).data.lastMessageId != message
            || getAfter(
              /databases/$(database)/documents/conversations/$(conversation)
            ).data.lastMessagePreview == 'Message removed'
          );
        allow delete: if false;
      }
    }

    match /journal_shares/{shareId} {
      allow get: if request.auth != null
        && request.auth.uid in resource.data.get('memberIds', [])
        && resource.data.get('status', '') == 'active'
        && activeFriendship(
          resource.data.get('friendshipId', ''),
          resource.data.get('ownerId', ''),
          resource.data.get('recipientId', '')
        );
      // Collection queries cannot prove a dynamic friendship document lookup.
      // Inbox/outbox queries constrain recipientId/ownerId and active status;
      // friendship cleanup constrains memberIds and active status.
      allow list: if request.auth != null
        && resource.data.get('status', '') == 'active'
        && (
          resource.data.get('recipientId', '') == request.auth.uid
          || resource.data.get('ownerId', '') == request.auth.uid
          || request.auth.uid in resource.data.get('memberIds', [])
        );
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerId', 'recipientId', 'journalId', 'friendshipId', 'memberIds',
          'status', 'includeTranscript', 'ownerProfile', 'recipientProfile',
          'journal', 'analysisVersion', 'sharedAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && activeFriendship(
          request.resource.data.friendshipId,
          request.resource.data.ownerId,
          request.resource.data.recipientId
        )
        && validPublicProfile(
          request.resource.data.ownerProfile,
          request.resource.data.ownerId
        )
        && validPublicProfile(
          request.resource.data.recipientProfile,
          request.resource.data.recipientId
        )
        && request.resource.data.includeTranscript is bool
        && request.resource.data.analysisVersion
          == request.resource.data.journal.analysisVersion
        && validShareJournal(
          request.auth.uid,
          request.resource.data.journalId,
          request.resource.data.journal,
          request.resource.data.includeTranscript
        );
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.journalId == resource.data.journalId
          && request.resource.data.friendshipId == resource.data.friendshipId
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerProfile', 'recipientProfile', 'updatedAt'
          ])
          && (
          (request.auth.uid == resource.data.ownerId
            && request.resource.data.recipientProfile == resource.data.recipientProfile
            && validPublicProfile(
              request.resource.data.ownerProfile,
              request.auth.uid
            ))
          || (request.auth.uid == resource.data.recipientId
            && request.resource.data.ownerProfile == resource.data.ownerProfile
            && validPublicProfile(
              request.resource.data.recipientProfile,
              request.auth.uid
            ))
          ))
        || (request.resource.data.ownerId == request.auth.uid
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'ownerId', 'recipientId', 'journalId', 'friendshipId', 'memberIds',
            'status', 'includeTranscript', 'ownerProfile', 'recipientProfile',
            'journal', 'analysisVersion', 'sharedAt', 'updatedAt'
          ])
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.journalId == resource.data.journalId
          && request.resource.data.status == 'active'
          && request.resource.data.memberIds == resource.data.memberIds
          && validPublicProfile(
            request.resource.data.ownerProfile,
            request.resource.data.ownerId
          )
          && validPublicProfile(
            request.resource.data.recipientProfile,
            request.resource.data.recipientId
          )
          && activeFriendship(
            request.resource.data.friendshipId,
            request.resource.data.ownerId,
            request.resource.data.recipientId
          )
          && request.resource.data.includeTranscript is bool
          && request.resource.data.analysisVersion
            == request.resource.data.journal.analysisVersion
          && validShareJournal(
            request.auth.uid,
            request.resource.data.journalId,
            request.resource.data.journal,
            request.resource.data.includeTranscript
          ))
      );
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }

    match /analysis_jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalId == jobId
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.retryCount == 0
        && request.resource.data.attemptCount == 0
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.get('aiConsentGranted', true) == true
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(jobId)
        ).data.userId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(jobId)
        ).data.analysisStatus == 'queued';
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.journalId == jobId
        && resource.data.status == 'failed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.journalId == resource.data.journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.attemptCount == 0
        && request.resource.data.retryCount == 0
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'processingStep', 'analysisVersion', 'startedAt',
          'completedAt', 'errorMessage', 'attemptCount', 'retryCount',
          'requestedAt'
        ])
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(jobId)
        ).data.analysisStatus == 'queued';
      allow delete: if false;
    }

    match /deletion_jobs/{journalId} {
      allow get: if request.auth != null
        && (
          exists(
            /databases/$(database)/documents/deletion_jobs/$(journalId)
          )
            ? resource.data.userId == request.auth.uid
            : ownsJournal(journalId)
        );
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'journalId',
          'status',
          'retryCount',
          'createdAt',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalId == journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.retryCount == 0
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(journalId)
        ).data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.journalId == journalId
        && resource.data.status == 'failed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.journalId == resource.data.journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage',
          'requestedAt'
        ]);
      allow delete: if false;
    }

    match /export_jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'journalIds',
          'exportKind',
          'status',
          'processingStep',
          'retryCount',
          'createdAt',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage',
          'completedItems'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalIds is list
        && request.resource.data.journalIds.size() >= 1
        && request.resource.data.journalIds.size() <= 50
        && request.resource.data.exportKind in [
          'audio',
          'transcript',
          'both'
        ]
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.retryCount == 0
        && request.resource.data.completedItems == 0;
      allow update, delete: if false;
    }
  }
}
