rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsJournal(journalId) {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(journalId)
        ).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if signedInAs(userId);
      allow delete: if false;

      match /journals/{journalId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == journalId
          && request.resource.data.analysisStatus == 'queued';
        allow update: if false;
        allow delete: if false;
      }
    }

    match /analysis_jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalId == jobId
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.retryCount == 0
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(jobId)
        ).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /deletion_jobs/{journalId} {
      allow get: if request.auth != null
        && (
          exists(
            /databases/$(database)/documents/deletion_jobs/$(journalId)
          )
            ? resource.data.userId == request.auth.uid
            : ownsJournal(journalId)
        );
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'journalId',
          'status',
          'retryCount',
          'createdAt',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalId == journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.retryCount == 0
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(journalId)
        ).data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.journalId == journalId
        && resource.data.status == 'failed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.journalId == resource.data.journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage',
          'requestedAt'
        ]);
      allow delete: if false;
    }

    match /export_jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'journalIds',
          'exportKind',
          'status',
          'processingStep',
          'retryCount',
          'createdAt',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage',
          'completedItems'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalIds is list
        && request.resource.data.journalIds.size() >= 1
        && request.resource.data.journalIds.size() <= 50
        && request.resource.data.exportKind in [
          'audio',
          'transcript',
          'both'
        ]
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.retryCount == 0
        && request.resource.data.completedItems == 0;
      allow update, delete: if false;
    }
  }
}
