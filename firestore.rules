rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function ownsJournal(journalId) {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(journalId)
        ).data.userId == request.auth.uid;
    }

    function activeFriendship(friendshipId, first, second) {
      let friendship = get(
        /databases/$(database)/documents/friendships/$(friendshipId)
      ).data;
      return friendship.status == 'accepted'
        && friendship.memberIds is list
        && friendship.memberIds.size() == 2
        && first in friendship.memberIds
        && second in friendship.memberIds;
    }

    function validPublicProfile(profile, userId) {
      return profile is map
        && profile.keys().hasOnly(['uid', 'displayName', 'username', 'photoUrl'])
        && profile.uid == userId;
    }

    function validShareJournal(userId, journalId, projection, includeTranscript) {
      let journal = get(
        /databases/$(database)/documents/users/$(userId)/journals/$(journalId)
      ).data;
      return journal.analysisStatus == 'complete'
        && projection.keys().hasOnly([
          'id', 'userId', 'entryType', 'title', 'prompt', 'recordedAt',
          'durationSeconds', 'videoUrl', 'audioUrl', 'writtenText',
          'mediaMimeType', 'thumbnailUrl', 'uploadStatus', 'analysisStatus',
          'analysisStep', 'analysisVersion', 'moodLabel', 'aiInsights',
          'insightProvider', 'transcript'
        ])
        && projection.keys().hasAll([
          'id', 'userId', 'entryType', 'prompt', 'recordedAt',
          'durationSeconds', 'videoUrl', 'audioUrl', 'writtenText',
          'analysisStatus', 'aiInsights'
        ])
        && projection.id == journalId
        && projection.userId == userId
        && projection.entryType == journal.get('entryType', 'video')
        && projection.title == journal.get('title', '')
        && projection.prompt == journal.get('prompt', 'Daily reflection')
        && projection.recordedAt == journal.recordedAt
        && projection.durationSeconds == journal.get('durationSeconds', 0)
        && projection.videoUrl == journal.get('videoUrl', '')
        && projection.audioUrl == journal.get('audioUrl', '')
        && projection.writtenText == journal.get('writtenText', '')
        && projection.mediaMimeType == journal.get('mediaMimeType', '')
        && projection.thumbnailUrl == journal.get('thumbnailUrl', '')
        && projection.uploadStatus == journal.get('uploadStatus', 'saved')
        && projection.analysisStatus == 'complete'
        && projection.analysisStep == journal.get('analysisStep', '')
        && projection.analysisVersion == journal.get('analysisVersion', '')
        && projection.moodLabel == journal.get('moodLabel', null)
        && projection.aiInsights == journal.get('aiInsights', [])
        && projection.insightProvider == journal.get('insightProvider', '')
        && (
          (includeTranscript == true
            && projection.transcript == journal.get('transcript', {}))
          || (includeTranscript == false
            && !projection.keys().hasAny(['transcript']))
        );
    }

    match /users/{userId} {
      allow read: if signedInAs(userId);
      allow create, update: if signedInAs(userId)
        && request.resource.data.usernameNormalized is string
        && getAfter(
          /databases/$(database)/documents/usernames/$(request.resource.data.usernameNormalized)
        ).data.uid == userId;
      allow delete: if false;

      match /journals/{journalId} {
        allow read: if signedInAs(userId);
        allow create: if signedInAs(userId)
          && request.resource.data.userId == userId
          && request.resource.data.id == journalId
          && request.resource.data.analysisStatus == 'queued';
        allow update: if false;
        allow delete: if false;
      }
    }

    match /usernames/{username} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameNormalized', 'displayName', 'photoUrl',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username
        && request.resource.data.usernameNormalized == username
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameNormalized == username;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.usernameNormalized == username
        && request.resource.data.keys().hasOnly([
          'uid', 'username', 'usernameNormalized', 'displayName', 'photoUrl',
          'updatedAt'
        ]);
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.usernameNormalized != username;
    }

    match /friendships/{friendship} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'requesterId', 'recipientId', 'memberIds', 'status', 'profiles',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.requesterId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.recipientId in request.resource.data.memberIds
        && request.resource.data.profiles.keys().hasOnly([
          request.resource.data.requesterId,
          request.resource.data.recipientId
        ])
        && validPublicProfile(
          request.resource.data.profiles[request.resource.data.requesterId],
          request.resource.data.requesterId
        )
        && validPublicProfile(
          request.resource.data.profiles[request.resource.data.recipientId],
          request.resource.data.recipientId
        )
        && request.resource.data.status == 'pending';
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.requesterId == resource.data.requesterId
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.memberIds == resource.data.memberIds
          && (
          (resource.data.status == 'pending'
            && request.auth.uid == resource.data.recipientId
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.status in ['accepted', 'declined'])
          || (resource.data.status == 'pending'
            && request.auth.uid == resource.data.requesterId
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.status == 'cancelled')
          || (resource.data.status == 'accepted'
            && request.resource.data.profiles == resource.data.profiles
            && request.resource.data.status == 'removed')
          || (request.resource.data.status == resource.data.status
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['profiles', 'updatedAt'])
            && request.resource.data.profiles.diff(resource.data.profiles)
              .affectedKeys().hasOnly([request.auth.uid])
            && validPublicProfile(
              request.resource.data.profiles[request.auth.uid],
              request.auth.uid
            ))
          ))
        || (resource.data.status in ['declined', 'cancelled', 'removed']
          && request.resource.data.keys().hasOnly([
            'requesterId', 'recipientId', 'memberIds', 'status', 'profiles',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.requesterId == request.auth.uid
          && request.resource.data.recipientId != request.auth.uid
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.status == 'pending'
          && request.resource.data.profiles.keys().hasOnly([
            request.resource.data.requesterId,
            request.resource.data.recipientId
          ])
          && validPublicProfile(
            request.resource.data.profiles[request.resource.data.requesterId],
            request.resource.data.requesterId
          )
          && validPublicProfile(
            request.resource.data.profiles[request.resource.data.recipientId],
            request.resource.data.recipientId
          ))
      );
      allow delete: if false;
    }

    match /journal_shares/{shareId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && resource.data.status == 'active'
        && activeFriendship(
          resource.data.friendshipId,
          resource.data.ownerId,
          resource.data.recipientId
        );
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'ownerId', 'recipientId', 'journalId', 'friendshipId', 'memberIds',
          'status', 'includeTranscript', 'ownerProfile', 'recipientProfile',
          'journal', 'analysisVersion', 'sharedAt', 'updatedAt'
        ])
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 2
        && activeFriendship(
          request.resource.data.friendshipId,
          request.resource.data.ownerId,
          request.resource.data.recipientId
        )
        && validPublicProfile(
          request.resource.data.ownerProfile,
          request.resource.data.ownerId
        )
        && validPublicProfile(
          request.resource.data.recipientProfile,
          request.resource.data.recipientId
        )
        && request.resource.data.includeTranscript is bool
        && request.resource.data.analysisVersion
          == request.resource.data.journal.analysisVersion
        && validShareJournal(
          request.auth.uid,
          request.resource.data.journalId,
          request.resource.data.journal,
          request.resource.data.includeTranscript
        );
      allow update: if request.auth != null && (
        (request.auth.uid in resource.data.memberIds
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.journalId == resource.data.journalId
          && request.resource.data.friendshipId == resource.data.friendshipId
          && request.resource.data.memberIds == resource.data.memberIds
          && request.resource.data.status == resource.data.status
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ownerProfile', 'recipientProfile', 'updatedAt'
          ])
          && (
          (request.auth.uid == resource.data.ownerId
            && request.resource.data.recipientProfile == resource.data.recipientProfile
            && validPublicProfile(
              request.resource.data.ownerProfile,
              request.auth.uid
            ))
          || (request.auth.uid == resource.data.recipientId
            && request.resource.data.ownerProfile == resource.data.ownerProfile
            && validPublicProfile(
              request.resource.data.recipientProfile,
              request.auth.uid
            ))
          ))
        || (request.resource.data.ownerId == request.auth.uid
          && resource.data.ownerId == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'ownerId', 'recipientId', 'journalId', 'friendshipId', 'memberIds',
            'status', 'includeTranscript', 'ownerProfile', 'recipientProfile',
            'journal', 'analysisVersion', 'sharedAt', 'updatedAt'
          ])
          && request.resource.data.recipientId == resource.data.recipientId
          && request.resource.data.journalId == resource.data.journalId
          && request.resource.data.status == 'active'
          && request.resource.data.memberIds == resource.data.memberIds
          && validPublicProfile(
            request.resource.data.ownerProfile,
            request.resource.data.ownerId
          )
          && validPublicProfile(
            request.resource.data.recipientProfile,
            request.resource.data.recipientId
          )
          && activeFriendship(
            request.resource.data.friendshipId,
            request.resource.data.ownerId,
            request.resource.data.recipientId
          )
          && request.resource.data.includeTranscript is bool
          && request.resource.data.analysisVersion
            == request.resource.data.journal.analysisVersion
          && validShareJournal(
            request.auth.uid,
            request.resource.data.journalId,
            request.resource.data.journal,
            request.resource.data.includeTranscript
          ))
      );
      allow delete: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }

    match /analysis_jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalId == jobId
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.retryCount == 0
        && request.resource.data.attemptCount == 0
        && getAfter(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(jobId)
        ).data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    match /deletion_jobs/{journalId} {
      allow get: if request.auth != null
        && (
          exists(
            /databases/$(database)/documents/deletion_jobs/$(journalId)
          )
            ? resource.data.userId == request.auth.uid
            : ownsJournal(journalId)
        );
      allow list: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'journalId',
          'status',
          'retryCount',
          'createdAt',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalId == journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.retryCount == 0
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)/journals/$(journalId)
        ).data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && resource.data.journalId == journalId
        && resource.data.status == 'failed'
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.journalId == resource.data.journalId
        && request.resource.data.status == 'queued'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage',
          'requestedAt'
        ]);
      allow delete: if false;
    }

    match /export_jobs/{jobId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'userId',
          'journalIds',
          'exportKind',
          'status',
          'processingStep',
          'retryCount',
          'createdAt',
          'startedAt',
          'completedAt',
          'errorCode',
          'errorMessage',
          'completedItems'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.journalIds is list
        && request.resource.data.journalIds.size() >= 1
        && request.resource.data.journalIds.size() <= 50
        && request.resource.data.exportKind in [
          'audio',
          'transcript',
          'both'
        ]
        && request.resource.data.status == 'queued'
        && request.resource.data.processingStep == 'queued'
        && request.resource.data.retryCount == 0
        && request.resource.data.completedItems == 0;
      allow update, delete: if false;
    }
  }
}
